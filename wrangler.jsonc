{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohammad",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2011be59-c5b7-4b1f-9df4-7e203f420cb7","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c6acc7237fd8459c82b88ff1d189de1c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
